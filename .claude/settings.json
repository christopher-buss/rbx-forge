{
	"includeCoAuthoredBy": true,
	"hooks": {
		"WorktreeCreate": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node scripts/worktree/create.ts",
						"timeout": 600
					}
				]
			}
		],
		"WorktreeRemove": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node scripts/worktree/remove.ts",
						"timeout": 120
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"commitlint-preflight@isentinel": true
	},
	"extraKnownMarketplaces": {
		"isentinel": {
			"source": {
				"source": "github",
				"repo": "christopher-buss/skills"
			}
		}
	}
}
