{
	"extends": "@isentinel/tsconfig/typescript",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "out-tsc/tsconfig.spec.tsbuildinfo",
		"lib": ["esnext"],
		"libReplacement": true,
		"rootDir": ".",
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "out-tsc/spec"
	},
	"references": [
		{
			"path": "./tsconfig.lib.json"
		}
	],
	"include": ["src/**/*.spec.ts", "src/**/*.spec-d.ts", "test/**/*.ts", "*.config.ts"]
}
