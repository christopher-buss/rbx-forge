{
	"extends": "@isentinel/tsconfig/typescript",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "out-tsc/tsconfig.spec.tsbuildinfo",
		"lib": ["esnext"],
		"libReplacement": true,
		"rootDir": ".",
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "out-tsc/spec"
	},
	"references": [
		{
			"path": "./tsconfig.lib.json"
		}
	],
	"include": [
		"src/**/*.spec.ts",
		"src/**/*.spec-d.ts",
		"src/lua.d.ts",
		"test/**/*.ts",
		"test/fixtures/rojo-plugin-v2.json",
		"test/fixtures/rojo-plugin-v3.json",
		"test/fixtures/rojo-plugin-v4.json",
		"test/fixtures/rojo-plugin-v5.json",
		"scripts/**/*.ts",
		"*.config.ts",
		"plugin/*.config.ts"
	]
}
