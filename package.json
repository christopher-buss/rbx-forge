{
	"name": "rbx-forge",
	"version": "2.0.0-alpha.0",
	"description": "A roblox-ts and Luau CLI tool for fully-managed Rojo projects",
	"keywords": [
		"rbxts",
		"roblox",
		"rojo",
		"typescript",
		"cli",
		"tool"
	],
	"homepage": "https://github.com/christopher-buss/rbx-forge#readme",
	"bugs": {
		"url": "https://github.com/christopher-buss/rbx-forge/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/christopher-buss/rbx-forge.git"
	},
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"contributors": [
		{
			"name": "osyrisrblx",
			"url": "https://github.com/osyrisrblx"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"bin": {
		"forge": "./bin/rbx-forge.js",
		"rbx-forge": "./bin/rbx-forge.js"
	},
	"files": [
		"bin",
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "tsdown",
		"build:native": "napi build --manifest-path reaper/Cargo.toml --platform --release --no-js --output-dir reaper/target/napi",
		"build:reaper": "cargo build --manifest-path reaper/Cargo.toml --release --bin forge-reaper && node -e \"const fs = require('node:fs'); const exe = process.platform === 'win32' ? '.exe' : ''; fs.mkdirSync('reaper/target/napi', { recursive: true }); fs.copyFileSync('reaper/target/release/forge-reaper' + exe, 'reaper/target/napi/forge-reaper' + exe);\"",
		"eslint-config": "pnpm dlx @eslint/config-inspector",
		"knip": "knip",
		"lint": "isentinel-lint",
		"lint:fix": "isentinel-lint --fix",
		"mutation": "stryker run stryker.config.ts",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:e2e": "vitest run --project e2e",
		"test:integration": "vitest run --project integration",
		"test:other-user": "vitest run --project other-user",
		"test:unit": "vitest run --project unit --coverage",
		"typecheck": "tsc --build",
		"watch": "tsdown --watch"
	},
	"dependencies": {
		"arktype": "catalog:runtime",
		"c12": "catalog:runtime",
		"jiti": "catalog:runtime"
	},
	"devDependencies": {
		"@isentinel/eslint-config": "catalog:lint",
		"@isentinel/tsconfig": "catalog:tsc",
		"@napi-rs/cli": "catalog:native",
		"@stryker-mutator/api": "catalog:mutation",
		"@stryker-mutator/core": "catalog:mutation",
		"@stryker-mutator/typescript-checker": "catalog:mutation",
		"@stryker-mutator/vitest-runner": "catalog:mutation",
		"@total-typescript/shoehorn": "catalog:test",
		"@types/node": "catalog:types",
		"@typescript/native": "catalog:tsc",
		"@vitest/coverage-v8": "catalog:test",
		"@vitest/eslint-plugin": "catalog:lint",
		"better-typescript-lib": "catalog:tsc",
		"eslint": "catalog:lint",
		"eslint-plugin-jest-extended": "catalog:lint",
		"eslint-plugin-n": "catalog:lint",
		"eslint-plugin-pnpm": "catalog:lint",
		"eslint_d": "catalog:lint",
		"jest-extended": "catalog:test",
		"knip": "catalog:lint",
		"memfs": "catalog:test",
		"oxlint": "catalog:lint",
		"oxlint-tsgolint": "catalog:lint",
		"publint": "catalog:lint",
		"tsdown": "catalog:build",
		"typescript": "catalog:tsc",
		"vitest": "catalog:test"
	},
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"engines": {
		"node": ">=24.12.0"
	},
	"napi": {
		"binaryName": "forge-native",
		"packageName": "@rbx-forge/native",
		"targets": [
			"x86_64-pc-windows-msvc",
			"aarch64-pc-windows-msvc",
			"x86_64-apple-darwin",
			"aarch64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"aarch64-unknown-linux-musl"
		]
	}
}
