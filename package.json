{
	"name": "rbx-forge",
	"version": "2.3.0",
	"description": "A roblox-ts and Luau CLI tool for fully-managed Rojo projects",
	"keywords": [
		"rbxts",
		"roblox",
		"rojo",
		"typescript",
		"cli",
		"tool"
	],
	"homepage": "https://github.com/christopher-buss/rbx-forge#readme",
	"bugs": {
		"url": "https://github.com/christopher-buss/rbx-forge/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/christopher-buss/rbx-forge.git"
	},
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"contributors": [
		{
			"name": "osyrisrblx",
			"url": "https://github.com/osyrisrblx"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"bin": {
		"forge": "./bin/rbx-forge.js",
		"rbx-forge": "./bin/rbx-forge.js"
	},
	"files": [
		"bin",
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "pnpm build:plugin && tsdown",
		"build:all": "pnpm build:native && pnpm build:reaper && pnpm build",
		"build:native": "napi build --manifest-path reaper/Cargo.toml --platform --release --no-js --output-dir reaper/target/napi",
		"build:plugin": "pnpm --filter @rbx-forge/studio-plugin build",
		"build:reaper": "cargo build --manifest-path reaper/Cargo.toml --release --bin forge-reaper --bin forge-studio-fixture && node -e \"const fs = require('node:fs'); const exe = process.platform === 'win32' ? '.exe' : ''; fs.mkdirSync('reaper/target/napi', { recursive: true }); for (const bin of ['forge-reaper', 'forge-studio-fixture']) fs.copyFileSync('reaper/target/release/' + bin + exe, 'reaper/target/napi/' + bin + exe);\"",
		"eslint-config": "pnpm dlx @eslint/config-inspector",
		"knip": "knip",
		"lint": "isentinel-lint",
		"lint:fix": "isentinel-lint --fix",
		"mutation": "node scripts/mutation/run.ts",
		"release": "bumpp",
		"release:bootstrap": "node scripts/release/bootstrap.ts",
		"release:publish": "node scripts/release/publish.ts",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:e2e": "vitest run --project e2e --project e2e-real-studio",
		"test:integration": "vitest run --project integration --project integration-real-studio",
		"test:other-user": "vitest run --project other-user",
		"test:plugin": "pnpm --filter @rbx-forge/studio-plugin test",
		"test:unit": "tsc --build tsconfig.lib.json && vitest run --project unit --coverage",
		"typecheck": "tsc --build",
		"preversion": "node scripts/release/check.ts",
		"watch": "tsdown --watch"
	},
	"dependencies": {
		"@msgpack/msgpack": "catalog:runtime",
		"arktype": "catalog:runtime",
		"c12": "catalog:runtime",
		"jiti": "catalog:runtime",
		"strip-json-comments": "catalog:runtime"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:lint",
		"@commitlint/config-conventional": "catalog:lint",
		"@commitlint/types": "catalog:lint",
		"@isentinel/eslint-config": "catalog:lint",
		"@isentinel/tsconfig": "catalog:tsc",
		"@napi-rs/cli": "catalog:native",
		"@stryker-mutator/api": "catalog:mutation",
		"@stryker-mutator/core": "catalog:mutation",
		"@stryker-mutator/typescript-checker": "catalog:mutation",
		"@stryker-mutator/vitest-runner": "catalog:mutation",
		"@total-typescript/shoehorn": "catalog:test",
		"@types/node": "catalog:types",
		"@typescript/native": "catalog:tsc",
		"@vitest/coverage-v8": "catalog:test",
		"@vitest/eslint-plugin": "catalog:lint",
		"better-typescript-lib": "catalog:tsc",
		"bumpp": "catalog:release",
		"eslint": "catalog:lint",
		"eslint-plugin-jest": "catalog:lint",
		"eslint-plugin-jest-extended": "catalog:lint",
		"eslint-plugin-n": "catalog:lint",
		"eslint-plugin-pnpm": "catalog:lint",
		"eslint_d": "catalog:lint",
		"jest-extended": "catalog:test",
		"knip": "catalog:lint",
		"memfs": "catalog:test",
		"oxlint": "catalog:lint",
		"oxlint-tsgolint": "catalog:lint",
		"publint": "catalog:lint",
		"tsdown": "catalog:build",
		"typescript": "catalog:tsc",
		"vitest": "catalog:test"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=24.12.0"
	},
	"napi": {
		"binaryName": "forge-native",
		"packageName": "@rbx-forge/native",
		"targets": [
			"x86_64-pc-windows-msvc",
			"aarch64-pc-windows-msvc",
			"x86_64-apple-darwin",
			"aarch64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"aarch64-unknown-linux-musl"
		]
	}
}
