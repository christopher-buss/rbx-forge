amends "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Builtins.pkl"

profiles = if (
       read?("env:AI_AGENT") != null
    || read?("env:CLAUDECODE") != null
    || read?("env:CLAUDE_CODE") != null
    || read?("env:CODEX_SANDBOX") != null
    || read?("env:CODEX_THREAD_ID") != null
    || read?("env:OPENCODE") != null
) List("agent") else List()

min_hk_version = "2.2.0"

local guards = new Mapping<String, Step> {
    // `batch = true` keeps each cmd.exe invocation under the 8191-char Windows
    // command-line limit; hk's auto-batch only accounts for Unix ARG_MAX. See
    // https://github.com/jdx/hk/discussions/971.
    ["check-merge-conflict"] = (Builtins.check_merge_conflict) {
        batch = true
    }
    ["detect-private-key"] = (Builtins.detect_private_key) {
        batch = true
    }
    ["check-added-large-files"] = (Builtins.check_added_large_files) {
        batch = true
        exclude = List("pnpm-lock.yaml", "reaper/Cargo.lock")
    }
}

local lint = new Step {
    glob = List("*.ts", "*.js", "*.mjs", "*.json", "*.jsonc", "*.md", "*.toml", "*.yaml", "*.yml")
    check = "pnpm lint"
    fix = "pnpm lint:fix"
    exclusive = true
}

local typecheck = new Step {
    glob = List("*.ts")
    check = "pnpm typecheck"
}

local checkedFiles = List(
    "src/**",
    "test/**",
    "scripts/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig*.json",
    "tsdown.config.ts",
    "vitest*.config.ts",
)

local build = new Step {
    glob = checkedFiles
    check = "pnpm build"
}

// Vitest's type tests run `tsc --build` too; running after typecheck avoids two
// concurrent builds writing the same tsbuildinfo (TS6305 on Windows).
local test = new Step {
    glob = checkedFiles
    check = "pnpm test"
    depends = List("typecheck")
}

local e2e = new Step {
    glob = checkedFiles
    check = "pnpm test:e2e"
    depends = List("build")
}

local native = new Step {
    glob = List("reaper/**")
    check = "cargo test --manifest-path reaper/Cargo.toml"
    depends = List("cargo-fmt", "cargo-clippy")
}

// hk 2.2.0 cannot load the builtin's own test cases.
local fmt = (Builtins.cargo_fmt) {
    tests = new {}
}

// CI runs clippy with `-D warnings`.
local clippy = (Builtins.cargo_clippy) {
    env {
        ["CARGO_BUILD_WARNINGS"] = "deny"
    }
}

local knip = new Step {
    check = "pnpm knip"
}

steps {
    ...guards
    ["lint"] = lint
    ["typecheck"] = typecheck
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "none"
        steps {
            ["build"] = (build) { profiles = List("agent") }
            ["test"] = (test) { profiles = List("agent") }
            ["e2e"] = (e2e) { profiles = List("agent") }
            ["cargo-fmt"] = (fmt) { profiles = List("agent") }
            ["cargo-clippy"] = (clippy) { profiles = List("agent") }
            ["native"] = (native) { profiles = List("agent") }
        }
    }
    ["pre-push"] {
        steps {
            ["knip"] = knip
            ["mutation"] {
                glob = List("src/**/*.ts")
                // URL remotes make hk's default-branch ref unresolvable.
                step_condition = "exec('git diff --name-only origin/main...HEAD -- src/') != ''"
                check = "pnpm mutation"
                profiles = List("agent")
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm exec commitlint --edit {{commit_msg_file}}"
            }
        }
    }
    ["post-merge"] {
        steps {
            ["install-deps"] {
                glob = List("pnpm-lock.yaml")
                check = "pnpm install"
            }
            ["mise-install"] {
                glob = List("mise.toml")
                check = "mise install"
            }
        }
    }
    ["check"] {
        steps {
            ["knip"] = knip
            ["build"] = build
            ["test"] = test
            ["e2e"] = e2e
            ["cargo-fmt"] = fmt
            ["cargo-clippy"] = clippy
            ["native"] = native
        }
    }
}
