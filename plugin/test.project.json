{
	"name": "forge-plugin-test",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/*.d.ts"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"plugin": { "$path": "out" },
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" },
					"@rbxts-js": { "$path": "../node_modules/@rbxts-js" }
				}
			}
		}
	}
}
